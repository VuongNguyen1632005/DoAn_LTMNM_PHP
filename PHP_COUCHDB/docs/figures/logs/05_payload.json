[
  {
    "selector": {
      "type": {
        "$eq": "order"
      },
      "customer.customer_id": {
        "$eq": "DEMO-C001"
      }
    },
    "use_index": [
      "_design/catalog_indexes",
      "customer_orders"
    ],
    "sort": [
      {
        "ordered_at": "desc"
      }
    ],
    "fields": [
      "_id",
      "status",
      "ordered_at",
      "totals",
      "payment"
    ],
    "limit": 20,
    "execution_stats": true,
    "skip": 0
  }
]